{
  "name": "rainmaker",
  "version": "0.1.2",
  "private": true,
  "description": "Turns labeled GitHub issues into pull requests with Claude Code or Codex, packaged for Umbrel.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "DATA_DIR=.data PORT=3000 node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
